{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-v3",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/chat", "/chat/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "ALLOWED_ORIGINS": "https://veck03.github.io,http://localhost:5173",
    "KNOWLEDGE_URL": "http://localhost:5173/portfolio/knowledge.json"
  }
}
